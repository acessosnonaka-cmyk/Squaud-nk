# ---------------------------------------------------------------
# SQUAD NK — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# Todas são OPCIONAIS: sem nenhuma delas o Squad roda localmente.
# ---------------------------------------------------------------

# --- Raiz de dados de trabalho (clientes, jobs, previews) ---
# Fica FORA do repositório. Padrão: ~/.squad-nk
SQUAD_DATA_HOME=

# --- LP Builder: publicação de preview ---
# Sem estas, o preview é servido em http://localhost:8090 (só na máquina local).
LP_PUBLISH_BASE_URL=
LP_PUBLISH_REMOTE_HOST=
LP_PUBLISH_REMOTE_USER=
LP_PUBLISH_REMOTE_PATH=
LP_PUBLISH_REMOTE_KEY=

# --- Design IA: override da localização do Revisor de Arte ---
DESIGNER_REVISOR_HOME=

# --- Legend IA ---
# Modelo do faster-whisper (base | small | medium | large-v3)
LEGEND_WHISPER_MODEL=

# --- Execução web (ETAPA WEB, ainda não implementada) ---
# Chave da API Anthropic para rodar os agentes sem Claude Code aberto.
# GERA CUSTO. Deixe vazia enquanto a operação for via Claude Code.
ANTHROPIC_API_KEY=
# Segredo de sessão da futura interface web
SQUAD_WEB_SESSION_SECRET=
