# ---------------------------------------------------------------
# SQUAD NK — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# Todas são OPCIONAIS: sem nenhuma delas o Squad roda localmente.
# ---------------------------------------------------------------

# --- Raiz de dados de trabalho (clientes, jobs, previews) ---
# Fica FORA do repositório. Padrão: ~/.squad-nk
SQUAD_DATA_HOME=

# --- LP Builder: publicação de preview ---
# Sem estas, o preview é servido em http://localhost:8090 (só na máquina local).
LP_PUBLISH_BASE_URL=
LP_PUBLISH_REMOTE_HOST=
LP_PUBLISH_REMOTE_USER=
LP_PUBLISH_REMOTE_PATH=
LP_PUBLISH_REMOTE_KEY=

# --- Design IA: override da localização do Revisor de Arte ---
DESIGNER_REVISOR_HOME=

# --- Diretor: Chromium do PDF de entrega ---
# Sem ela, o motor descobre pelo Playwright, pelo PATH ou por PLAYWRIGHT_BROWSERS_PATH.
SQUAD_CHROMIUM=

# --- Legend IA ---
# Modelo do faster-whisper (base | small | medium | large-v3)
LEGEND_WHISPER_MODEL=

# ---------------------------------------------------------------
# SQUAD NK WEB (apps/web) — Etapa 1
# Nenhum valor real entra no git. Copie para .env e preencha.
# ---------------------------------------------------------------

# OBRIGATÓRIO. Sem isso o app recusa subir: o cookie de sessão seria forjável.
# Gere com: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SQUAD_WEB_SESSION_SECRET=

# Primeiro usuário, criado só quando a tabela está vazia. Depois disso é ignorado.
SQUAD_ADMIN_EMAIL=
SQUAD_ADMIN_PASSWORD=

# Onde o navegador acessa. 127.0.0.1 mantém fora da rede local.
SQUAD_WEB_BIND=127.0.0.1
SQUAD_WEB_PORT=8000

# Marque 1 apenas quando servir por HTTPS (exige cookie Secure).
SQUAD_COOKIE_SECURE=0

# Limites operacionais
SQUAD_MAX_UPLOAD_MB=500
SQUAD_GLOBAL_SLOTS=2
SQUAD_SLOTS_WHISPER=1

# --- Etapa 2: runtime de inteligência (ainda NÃO implementado) ---
# Deixe vazias. Nenhum agente de LLM roda nesta versão, e nada é cobrado
# enquanto estiverem em branco.
ANTHROPIC_API_KEY=
