# ---------------------------------------------------------------
# SQUAD NK — nada de segredo, dado de cliente ou artefato de execução
# ---------------------------------------------------------------

# Segredos
.env
.env.*
!.env.example
*.pem
*.key
id_ed25519*
id_rsa*
.credentials.json
**/publish.conf.json

# Dados de cliente e material de trabalho (NUNCA versionar)
**/clients/
**/previews/
**/jobs/
**/output/
**/entregas/
**/revisoes/
**/validacao/
**/calibracao/aprovadas/
**/calibracao/reprovadas/
.tmp-drive/
entrada de vídeo/
entrega/

# Dependências e caches regeneráveis
venv/
.venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
runtime/lib/
shared/skills/humanizer/

# Artefatos de execução
*.ass
*.log
*.mp4
*.mov
*.zip

# Sistema
*:Zone.Identifier
.DS_Store
Thumbs.db
desktop.ini

# Pastas de dados do Design IA: symlinks criados por scripts/setup.sh
agents/design-ia/engine/clients
agents/design-ia/engine/jobs
agents/design-ia/engine/output
shared/runtime/

# --- Squad NK Web: dados de produção NUNCA entram no git ---
# uploads, jobs, outputs e banco vivem em SQUAD_DATA_HOME (fora do repo);
# estas linhas cobrem quem apontar SQUAD_DATA_HOME para dentro do clone.
/data/
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
apps/web/.venv/
apps/web/.run/
